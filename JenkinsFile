pipeline {
    agent any

    environment {
        SONARQUBE_SERVER = 'sonar' // Nom configuré pour SonarQube dans Jenkins
        SONARQUBE_TOKEN = credentials('sonardevops') // Jeton d'authentification sécurisé
       // NEXUS_CREDENTIALS_ID = 'nexus'
        DOCKER_CREDENTIALS_ID = 'docker'
        DOCKER_IMAGE = "BaghouliAmine/gestionstationski"
        DOCKER_TAG = "latest"
        NEXUS_REPO = "https://192.168.1.101:8082/repository/NexusRepository"
        APP_VERSION = '1.0.0'
        DOCKER_TAG = '1.0.0'
    }

    stages {
        stage('Clone repository') {
            steps {
                git branch: 'BaghouliAmine', url: 'https://github.com/mehdi147899/deops_projet.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean install -DskipTests' // Compile et package sans tests
            }
        }

        stage('Run Unit Tests') {
            steps {
                sh 'mvn test' // Exécute les tests unitaires avec Mockito et JUnit
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv(SONARQUBE_SERVER) {
                    sh 'mvn sonar:sonar -Dsonar.projectKey=gestion-station-ski -Dsonar.sources=src/main/java -Dsonar.host.url=http://192.168.1.101:9000 -Dsonar.login=${SONARQUBE_TOKEN}'
                }
            }
        }

       /* stage('Deploy to Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: NEXUS_CREDENTIALS_ID, usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    sh "mvn deploy -DaltDeploymentRepository=nexus::default::${NEXUS_REPO} -Dnexus.username=${NEXUS_USER} -Dnexus.password=${NEXUS_PASS}"
                }
            }
        } */

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                }
            }
        }

        stage('Push Docker Image to Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: DOCKER_CREDENTIALS_ID, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh "echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin"
                    sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                }
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                script {
                    sh 'docker compose up -d'
                }
            }
        }

        stage('Monitor Services') {
            steps {
                script {
                    // Démarrer un outil de monitoring comme Grafana et Prometheus
                    sh 'docker compose -f monitoring-compose.yml up -d'
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline terminé.'
        }
        cleanup {
            sh 'docker-compose down'
        }
    }
}
