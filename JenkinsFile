pipeline {
    agent any


    environment {
        SONARQUBE_SERVER = 'sonar' // Nom configuré pour SonarQube dans Jenkins
        SONARQUBE_TOKEN = credentials('sonardevops') // Jeton d'authentification sécurisé
    }

    stages {
        stage('Clone repository') {
            steps {
                git branch: 'BaghouliAmine', url: 'https://github.com/mehdi147899/deops_projet.git'
            }
        }

        stage('Build and Test') {
            steps {
                sh 'mvn clean install -DskipTests' 
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar -Dsonar.projectKey=gestion-station-ski -Dsonar.sources=src/main/java -Dsonar.host.url=http://192.168.1.101:9000 -Dsonar.login=${SONARQUBE_TOKEN}'
                }
            }
        }

        /*
        stage('Deploy to Nexus') {
            steps {

               sh 'mvn deploy' 
            }
        }  */

        
    }
}
